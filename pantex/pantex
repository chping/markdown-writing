#!/usr/bin/env bash
set -euo pipefail

helpdoc() {
    cat <<EOF
Pandoc Markdown To Latex (tex)

Usage:
     pantex [-i <input markdown file(s)...>] [-o <output-folder>] [--backup=true|false]
Options:
     -i <input markdown file(s)>    Specify the Markdown files to convert. You can specify multiple Markdown files. 
                                    If not provided, all .md files in the current directory will be used.
     -o <output-folder-name>           Specify the name of the output folder. If not provided, the default is 'exported'.
     --backup=true|false   If true, will back up the existing output folder before overwriting. Default is false.

Note:
     Please put the corresponding BibTex lib under the 'panlib' folder with name of 'bibtex.bib'
EOF
}

PANDOC=/usr/local/bin/pandoc
PANDOC_CROSSREF=/usr/local/bin/pandoc-crossref
# Get script install path
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Initialize variables
INPUT_FILES=()
BACKUP=false  # Default is falses
USE_SPECIFIED_FILES=false  # Track whether -i option is used
OUTPUT_DIR="exported"  # Default output folder name

# Parse command-line options
while [[ $# -gt 0 ]]; do
    case $1 in
        -i)
            USE_SPECIFIED_FILES=true
            shift
            while [[ $# -gt 0 && $1 != -* ]]; do
                INPUT_FILES+=("$1")
                shift
            done
            ;;
        -o)
            shift
            OUTPUT_DIR="$1"
            shift
            ;;
        --backup=true)
            BACKUP=true
            shift
            ;;
        --backup=false)
            BACKUP=false
            shift
            ;;
        -h|--help)
            helpdoc
            exit 0
            ;;
        *)
            helpdoc
            exit 1
            ;;
    esac
done

# If -i option was used but no files were provided, show an error
if [ "$USE_SPECIFIED_FILES" = true ] && [ ${#INPUT_FILES[@]} -eq 0 ]; then
    echo "Error: No Markdown files specified with -i option."
    exit 1
fi

# If no input files were provided (i.e., -i was not used), find all .md files in the current directory
if [ "$USE_SPECIFIED_FILES" = false ]; then
    # 用 glob 而不是 ls，避免空格问题
    shopt -s nullglob
    INPUT_FILES=( *.md )
    shopt -u nullglob

    if [ ${#INPUT_FILES[@]} -eq 0 ]; then
        echo "Error: No Markdown files found in the current directory."
        exit 1
    fi

    # 如果需要排序（比如按字母顺序）
    IFS=$'\n' INPUT_FILES=($(printf '%s\n' "${INPUT_FILES[@]}" | sort))
    unset IFS
fi

# Ensure all specified input files exist
for file in "${INPUT_FILES[@]}"; do
    if [ ! -f "$file" ]; then
        echo "Error: File '$file' does not exist."
        exit 1
    fi
done

# Function to backup the existing output files
backup_file() {
    if [ -d "$OUTPUT_DIR" ]; then
        local base_name="${OUTPUT_DIR}"
        local date_str=$(date +"%Y-%m%d")
        local counter=1
        local backup_name="${base_name}-${date_str}-${counter}"

        while [ -d "$backup_name" ]; do
            counter=$((counter + 1))
            backup_name="${base_name}-${date_str}-${counter}"
        done

        mv "$OUTPUT_DIR" "$backup_name"
        echo "Backup created: $backup_name"
    fi
}

# Backup the existing output file if the --backup option is true (default)
if [ "$BACKUP" = true ]; then
    backup_file
fi
# Check and create the output folder
rm -rf "$OUTPUT_DIR"
mkdir -p "$OUTPUT_DIR"

# Check if 'docxlib' exist in current folder, if not, use the docxlib in SCRIPT home dir
if [ -d "./texlib" ]; then
    LIB_PATH="$(pwd)/texlib"
else
    LIB_PATH="$SCRIPT_DIR/texlib"
fi

CONFIG_YAML=$LIB_PATH/config.yaml
CROSSREF_YAML=$LIB_PATH/crossref.yaml
# CSL_FILE=$LIB_PATH/reference.csl
TEMPLATE_MAIN=$LIB_PATH/template-main.latex
# BIBTEX_FILE=$LIB_PATH/bibtex.bib
# PAGE_LINE_BREAK_FILTER=$LIB_PATH/page-and-line-break.lua
# MATH_FILTER=$LIB_PATH/fix-math.lua
IMAGE_PATH_FILTER=$LIB_PATH/image-path-filter.lua

# Use pandoc converting all Markdown files to Latex and save *.tex to OUTPUT_DIR
for md in "${INPUT_FILES[@]}"; do
  # Processing Markdown files only
  [ -e "$md" ] || continue
  base="${md##*/}"             # 仅取文件名
  base="${base%.md}"           # 去 .md 后缀
  out_tex="$OUTPUT_DIR/${base}.tex"
  $PANDOC "$md" --defaults="$CONFIG_YAML" \
    --from=markdown \
    --to=latex \
    --standalone=false \
    --biblatex \
    -M suppress-bibliography=true \
    --filter $PANDOC_CROSSREF -M "crossrefYaml=$CROSSREF_YAML" \
    --lua-filter $IMAGE_PATH_FILTER \
    -o "$out_tex"
done

# List all exported .tex files and ordered by filename
TMP_LIST="$(mktemp)"
for md in "${INPUT_FILES[@]}"; do
  base="${md##*/}"
  base="${base%.md}"
  tex="$OUTPUT_DIR/${base}.tex"
  # 跳过不存在或 main.tex
  [ -f "$tex" ] || continue
  [ "$base" = "main" ] && continue
  printf '%s\n' "\\input{$(basename "$tex")}" >> "$TMP_LIST"
done

# Generate the main.tex and save it to OUTPUT_DIR
main_file="$OUTPUT_DIR/main.tex"
# sed "/%%INPUTS%%/r $TMP_LIST" "$TEMPLATE_MAIN" | sed 's/%%INPUTS%%//' > "$main_file"
$PANDOC  --defaults="$CONFIG_YAML" \
     --from=markdown --to=latex --standalone \
    --template="$TEMPLATE_MAIN" \
    -M "inputs=$(cat "$TMP_LIST")" \
    --metadata-file=<(printf "inputs: |\n"; sed 's/^/  /' "$TMP_LIST") \
    -o "$main_file" /dev/null
rm -f "$TMP_LIST"

# Print the result
echo "All Exported Latex files have been saved to folder: '$OUTPUT_DIR'"
ls "$OUTPUT_DIR"